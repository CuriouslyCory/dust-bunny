# Copy to .env for local development (`pnpm dev` then also serves the API in api/).
# On Vercel, set these under Settings → Environment Variables.

# --- Database (required for the leaderboard API, accounts and cloud save) ---
# On Vercel the Neon integration injects DATABASE_URL automatically. Locally, point it at a Neon
# branch rather than production.
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# Optional: salt for the hashed client IPs stored for rate limiting.
LEADERBOARD_IP_SALT=

# --- Accounts (Better Auth) ---
# Required for sign-in. Generate with: openssl rand -base64 32
# Without it, accounts are off and every score posts as anonymous.
BETTER_AUTH_SECRET=
# Canonical site origin, e.g. https://dustbunny.example (no trailing slash). Set it for Production.
# Preview and local hosts are recognised from the request (Vercel's VERCEL_* vars, localhost).
BETTER_AUTH_URL=

# --- Sign-in providers: each is offered only when both its id and secret are set ---
# Google: https://console.cloud.google.com/apis/credentials → Create credentials → OAuth client ID
#   Application type: Web application
#   Authorized redirect URIs: https://<your-domain>/api/auth/callback/google
#                             http://localhost:5173/api/auth/callback/google  (local dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Discord: https://discord.com/developers/applications → New Application → OAuth2
#   Redirects: https://<your-domain>/api/auth/callback/discord
#              http://localhost:5173/api/auth/callback/discord  (local dev)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
