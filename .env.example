# Only needed for the leaderboard API (api/leaderboard.ts), e.g. with `vercel dev`.
# On Vercel the Neon integration injects DATABASE_URL automatically.
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# Optional: salt for the hashed client IPs stored for rate limiting.
LEADERBOARD_IP_SALT=
